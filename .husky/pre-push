#!/usr/bin/env sh
echo ""
echo "🚀 Run Tests..."

npm test
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "❌ Tests failed or coverage is too low."
  echo "➡️ Check for errors above, fix them and try again."
  echo "💡 Coverage may not reach the threshold set in jest.config."
  exit 1
fi

echo ""
echo "✅ Tests passed. Push allowed."